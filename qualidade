#!/usr/bin/env bash
set -euo pipefail

TOOLBOX_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
IMAGE="${QUALIDADE_IMAGEM:-laravel-qualidade:php8.4}"
NODE_IMAGE="${QUALIDADE_IMAGEM_NODE:-node:22-alpine}"
PRETTIER="prettier@3.3.3"
STYLELINT="stylelint@16.10.0"
STYLELINT_CONFIG="stylelint-config-standard@36.0.1"
ESLINT="eslint@9.13.0"
ESLINT_JS="@eslint/js@9.13.0"
ESLINT_GLOBALS="globals@15.11.0"
FRONTEND_DIR="${QUALIDADE_FRONTEND_DIR:-scripts/ci/frontend}"

BASE="origin/homologation"
LEVEL=6
TESTS=""
THREADS=1
APPLY=0

usage() {
    cat <<'HELP'
Uso: qualidade <comando> [opções]

Comandos:
  phpstan     PHPStan + Larastan nos arquivos de app/ alterados na branch
  rector      Rector em simulação nos arquivos de app/ alterados na branch
  cobertura   testes com PCOV, relatório HTML e dados para o Infection
  infection   cobertura e depois Infection só nas linhas alteradas
  tudo        phpstan, rector e infection, com um resumo no final
  frontend    Prettier (formato), Stylelint (CSS: erros e regras do DESIGN.md) e ESLint (JS: erros e JS moderno) nos .css e .js de public/ alterados

Opções:
  --base=<ref>      branch ou commit de comparação (padrão: origin/homologation)
  --nivel=<0-10>    nível do PHPStan (padrão: 6)
  --testes=<path>   roda só esses testes na cobertura e no Infection
  --threads=<n>     threads do Infection (padrão: 1, por causa do banco de testes)
  --aplicar         rector: grava as mudanças nos arquivos (exige os arquivos sem mudanças pendentes)
                    frontend: formata os arquivos alterados com o Prettier
HELP
}

COMMAND="${1:-ajuda}"
[ $# -gt 0 ] && shift

for arg in "$@"; do
    case "$arg" in
        --base=*)    BASE="${arg#*=}" ;;
        --nivel=*)   LEVEL="${arg#*=}" ;;
        --testes=*)  TESTS="${arg#*=}" ;;
        --threads=*) THREADS="${arg#*=}" ;;
        --aplicar)   APPLY=1 ;;
        *) echo "Opção desconhecida: $arg" >&2; usage; exit 2 ;;
    esac
done

if [ "$COMMAND" = "ajuda" ] || [ "$COMMAND" = "--help" ] || [ "$COMMAND" = "-h" ]; then
    usage
    exit 0
fi

PROJECT_DIR="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "Rode dentro de um projeto com git." >&2
    exit 1
}
PROJECT_NAME="$(basename "$PROJECT_DIR")"
CACHE_DIR="$TOOLBOX_DIR/cache"
REPORTS_DIR="$TOOLBOX_DIR/relatorios/$PROJECT_NAME"
mkdir -p "$CACHE_DIR" "$REPORTS_DIR"

run_container() {
    local linux_host=()
    [ "$(uname -s)" = "Linux" ] && linux_host=(--add-host=host.docker.internal:host-gateway)

    docker run --rm \
        --user "$(id -u):$(id -g)" \
        ${linux_host[@]+"${linux_host[@]}"} \
        -e HOME=/tmp \
        -e COMPOSER_HOME=/cache/composer \
        -e DB_HOST=host.docker.internal \
        -e REDIS_HOST=host.docker.internal \
        -v "$PROJECT_DIR":/app \
        -v "$CACHE_DIR":/cache \
        -v "$REPORTS_DIR":/relatorios \
        -v "$TOOLBOX_DIR/modelos":/modelos:ro \
        -v "$TOOLBOX_DIR/scripts":/scripts:ro \
        -w /app \
        "$IMAGE" "$@"
}

merge_base() {
    git -C "$PROJECT_DIR" merge-base "$BASE" HEAD || {
        echo "Não achei a base '$BASE'. Rode 'git fetch' ou passe --base=<ref>." >&2
        exit 1
    }
}

report() {
    run_container php /scripts/relatorio.php "$1" "$(merge_base)"
}

changed_php_files() {
    local merge_base
    merge_base="$(merge_base)"

    {
        git -C "$PROJECT_DIR" diff --name-only --diff-filter=ACMR "$merge_base" -- 'app/*.php'
        git -C "$PROJECT_DIR" ls-files --others --exclude-standard -- 'app/*.php'
    } | sort -u | while read -r file; do
        [ -f "$PROJECT_DIR/$file" ] && echo "$file"
    done
}

package_version() {
    run_container php -r '
        $lock = json_decode(file_get_contents("composer.lock"), true);
        foreach (array_merge($lock["packages"] ?? [], $lock["packages-dev"] ?? []) as $package) {
            if ($package["name"] === $argv[1]) {
                echo ltrim($package["version"], "v");
            }
        }
    ' "$1"
}

ensure_larastan() {
    local laravel carbon constraint dir
    laravel="$(package_version laravel/framework)"
    [ -n "$laravel" ] || { echo "Não achei laravel/framework no composer.lock." >&2; exit 1; }
    carbon="$(package_version nesbot/carbon)"

    constraint="^3.0"
    [ "${laravel%%.*}" -lt 11 ] && constraint="^2.0"

    dir="larastan/laravel-$laravel"
    if [ ! -x "$CACHE_DIR/$dir/vendor/bin/phpstan" ]; then
        echo "Instalando o Larastan para o Laravel $laravel (só na primeira vez)..." >&2
        mkdir -p "$CACHE_DIR/$dir"
        echo '{"config": {"allow-plugins": {"php-http/discovery": false}}}' > "$CACHE_DIR/$dir/composer.json"
        run_container composer --working-dir="/cache/$dir" require --no-interaction --no-progress --quiet \
            "larastan/larastan:$constraint" "laravel/framework:$laravel" ${carbon:+"nesbot/carbon:$carbon"} >&2
    fi

    echo "/cache/$dir"
}

run_phpstan() {
    local files larastan
    files="$(changed_php_files)"
    if [ -z "$files" ]; then
        echo "PHPStan: nenhum arquivo PHP de app/ alterado em relação a $BASE."
        return 0
    fi

    larastan="$(ensure_larastan)"

    {
        echo "includes:"
        echo "    - $larastan/vendor/larastan/larastan/extension.neon"
        echo "    - /modelos/phpstan.neon"
        echo "parameters:"
        echo "    level: $LEVEL"
        echo "    tmpDir: /cache/phpstan-tmp/$PROJECT_NAME"
        echo "    bootstrapFiles:"
        echo "        - /app/vendor/autoload.php"
        echo "    paths:"
        echo "$files" | sed 's#^#        - /app/#'
    } > "$REPORTS_DIR/phpstan.neon"

    echo "PHPStan nível $LEVEL em $(echo "$files" | wc -l | tr -d ' ') arquivos alterados..."
    run_container "$larastan/vendor/bin/phpstan" analyse -c /relatorios/phpstan.neon --memory-limit=1G --no-progress \
        --error-format=json > "$REPORTS_DIR/phpstan.json" || true

    report phpstan | tee "$REPORTS_DIR/phpstan.txt"
}

run_rector() {
    local files
    files="$(changed_php_files)"
    if [ -z "$files" ]; then
        echo "Rector: nenhum arquivo PHP de app/ alterado em relação a $BASE."
        return 0
    fi

    if [ "$APPLY" -eq 1 ]; then
        local pending
        # shellcheck disable=SC2086
        pending="$(git -C "$PROJECT_DIR" status --porcelain -- $files)"
        if [ -n "$pending" ]; then
            echo "Rector: não apliquei, porque estes arquivos têm mudanças sem commit:" >&2
            echo "$pending" >&2
            echo "Faça o commit (ou git stash) e rode de novo, para o diff mostrar só o que o Rector mudou." >&2
            return 1
        fi

        echo "Rector (aplicando) em $(echo "$files" | wc -l | tr -d ' ') arquivos alterados..."
        # shellcheck disable=SC2086
        run_container rector process --config=/modelos/rector.php --no-progress-bar $files \
            | tee "$REPORTS_DIR/rector.txt"

        echo
        git -C "$PROJECT_DIR" diff --stat
        echo "Revise na IDE (ou com git diff), rode o Pint e os testes. Para desfazer: git restore <arquivo>."
        return 0
    fi

    echo "Rector (simulação) em $(echo "$files" | wc -l | tr -d ' ') arquivos alterados..."
    # shellcheck disable=SC2086
    run_container rector process --dry-run --config=/modelos/rector.php --no-progress-bar --output-format=json $files \
        > "$REPORTS_DIR/rector.json" || true

    report rector | tee "$REPORTS_DIR/rector.txt"
}

run_coverage() {
    rm -rf "$REPORTS_DIR/cobertura" "$REPORTS_DIR/cobertura-html"
    mkdir -p "$REPORTS_DIR/cobertura"

    echo "Testes com cobertura${TESTS:+ em $TESTS}..."
    # shellcheck disable=SC2086
    run_container php vendor/bin/phpunit $TESTS \
        --coverage-filter app \
        --coverage-html /relatorios/cobertura-html \
        --coverage-xml /relatorios/cobertura/coverage-xml \
        --coverage-clover /relatorios/cobertura/clover.xml \
        --log-junit /relatorios/cobertura/junit.xml \
        --coverage-text --only-summary-for-coverage-text \
        | tee "$REPORTS_DIR/cobertura.txt"

    report cobertura | tee -a "$REPORTS_DIR/cobertura.txt"
    echo "Relatório: $REPORTS_DIR/cobertura-html/index.html"
}

run_infection() {
    run_coverage || true

    cat > "$REPORTS_DIR/infection.json5" <<JSON
{
    "source": { "directories": ["app"] },
    "timeout": 30,
    "tmpDir": "/cache/infection-tmp/$PROJECT_NAME",
    "logs": {
        "text": "/relatorios/infection.log",
        "html": "/relatorios/infection.html",
        "summary": "/relatorios/infection-resumo.log",
        "json": "/relatorios/infection.json"
    },
    "phpUnit": { "configDir": "/app" },
    "mutators": { "@default": true }
}
JSON

    local untracked
    untracked="$(git -C "$PROJECT_DIR" ls-files --others --exclude-standard -- 'app/*.php')"

    if [ -n "$untracked" ]; then
        echo "$untracked" | xargs git -C "$PROJECT_DIR" add --intent-to-add --
    fi

    local status=0

    echo "Infection nas linhas alteradas em relação a $BASE..."
    run_container infection \
        --configuration=/relatorios/infection.json5 \
        --coverage=/relatorios/cobertura \
        --skip-initial-tests \
        --git-diff-lines \
        --git-diff-base="$BASE" \
        --threads="$THREADS" \
        --no-progress \
        --no-interaction \
        > "$REPORTS_DIR/infection.txt" 2>&1 || status=$?

    if [ -n "$untracked" ]; then
        echo "$untracked" | xargs git -C "$PROJECT_DIR" reset --quiet --
    fi

    if [ "$status" -ne 0 ]; then
        tail -20 "$REPORTS_DIR/infection.txt"
        return "$status"
    fi

    report infection | tee -a "$REPORTS_DIR/infection.txt"
    echo "Relatório: $REPORTS_DIR/infection.html"
}

changed_frontend_files() {
    local merge_base
    merge_base="$(merge_base)"

    {
        git -C "$PROJECT_DIR" diff --name-only --diff-filter=ACMR "$merge_base" -- 'public/css/*.css' 'public/js/*.js'
        git -C "$PROJECT_DIR" ls-files --others --exclude-standard -- 'public/css/*.css' 'public/js/*.js'
    } | sort -u | while read -r file; do
        [ -f "$PROJECT_DIR/$file" ] && echo "$file"
    done
}

run_node_container() {
    docker run --rm \
        --user "$(id -u):$(id -g)" \
        -e HOME=/tmp \
        -e npm_config_cache=/cache/npm \
        -e npm_config_update_notifier=false \
        -v "$PROJECT_DIR":/app \
        -v "$CACHE_DIR":/cache \
        -v "$TOOLBOX_DIR/modelos":/modelos:ro \
        -w /app \
        "$NODE_IMAGE" "$@"
}

ensure_frontend_tools() {
    local stamp="$CACHE_DIR/frontend/.versoes"
    local wanted="$PRETTIER $STYLELINT $STYLELINT_CONFIG $ESLINT $ESLINT_JS $ESLINT_GLOBALS"

    cp "$TOOLBOX_DIR/modelos/eslint.config.mjs" "$CACHE_DIR/frontend/eslint.config.mjs" 2>/dev/null || true

    [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$wanted" ] && return 0

    echo "Instalando $wanted em $CACHE_DIR/frontend..."
    mkdir -p "$CACHE_DIR/frontend"
    run_node_container npm install --prefix /cache/frontend --no-save --no-audit --no-fund --loglevel=error $wanted
    echo "$wanted" > "$stamp"
    cp "$TOOLBOX_DIR/modelos/eslint.config.mjs" "$CACHE_DIR/frontend/eslint.config.mjs"
}

has_project_frontend_tools() {
    [ -f "$PROJECT_DIR/$FRONTEND_DIR/package-lock.json" ]
}

ensure_project_frontend_tools() {
    local stamp="$PROJECT_DIR/$FRONTEND_DIR/node_modules/.qualidade-lock"
    local wanted
    wanted="$(cksum < "$PROJECT_DIR/$FRONTEND_DIR/package-lock.json")"

    [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$wanted" ] && return 0

    echo "Instalando as ferramentas do projeto (npm ci em $FRONTEND_DIR)..."
    run_node_container npm ci --prefix "/app/$FRONTEND_DIR" --no-audit --no-fund --loglevel=error
    echo "$wanted" > "$stamp"
}

select_frontend_tools() {
    if has_project_frontend_tools; then
        ensure_project_frontend_tools
        FRONTEND_ORIGIN="do projeto ($FRONTEND_DIR)"
        FRONTEND_BIN="/app/$FRONTEND_DIR/node_modules/.bin"
        PRETTIER_CONFIG="/app/$FRONTEND_DIR/prettier.json"
        STYLELINT_ARGS=(--config "/app/$FRONTEND_DIR/stylelint.json")
        ESLINT_CONFIG="/app/$FRONTEND_DIR/eslint.config.mjs"
        return 0
    fi

    ensure_frontend_tools
    FRONTEND_ORIGIN="da caixa (modelos/)"
    FRONTEND_BIN="/cache/frontend/node_modules/.bin"
    PRETTIER_CONFIG="/modelos/prettier.json"
    STYLELINT_ARGS=(--config /modelos/stylelint.json --config-basedir /cache/frontend)
    ESLINT_CONFIG="/cache/frontend/eslint.config.mjs"
}

run_frontend() {
    local files=() css=() js=() file status=0
    while read -r file; do
        files+=("$file")
        [[ "$file" == *.css ]] && css+=("$file")
        [[ "$file" == *.js ]] && js+=("$file")
    done < <(changed_frontend_files)

    if [ ${#files[@]} -eq 0 ]; then
        echo "Nenhum .css ou .js de public/ alterado em relação a $BASE."
        echo "nenhum arquivo alterado" > "$REPORTS_DIR/resumo-frontend.txt"
        return 0
    fi

    select_frontend_tools
    echo "Ferramentas e configuração $FRONTEND_ORIGIN."
    echo

    echo "── Prettier: formato (${#files[@]} arquivo(s)) ───────────────────────────"
    if [ "$APPLY" = 1 ]; then
        run_node_container "$FRONTEND_BIN/prettier" --config "$PRETTIER_CONFIG" --write "${files[@]}"
    else
        run_node_container "$FRONTEND_BIN/prettier" --config "$PRETTIER_CONFIG" --check "${files[@]}" || {
            status=1
            echo "Para formatar: qualidade frontend --aplicar (faça a formatação num commit separado)."
        }
    fi

    if [ ${#css[@]} -gt 0 ]; then
        echo
        echo "── Stylelint: erros e regras do DESIGN.md (${#css[@]} arquivo(s)) ─────────"
        run_node_container "$FRONTEND_BIN/stylelint" "${STYLELINT_ARGS[@]}" "${css[@]}" || status=1
    fi

    if [ ${#js[@]} -gt 0 ]; then
        echo
        echo "── ESLint: erros e JS moderno (${#js[@]} arquivo(s)) ─────────────────────"
        run_node_container "$FRONTEND_BIN/eslint" --config "$ESLINT_CONFIG" "${js[@]}" || status=1
    fi

    if [ "$status" = 0 ]; then
        echo "ok em ${#files[@]} arquivo(s)" > "$REPORTS_DIR/resumo-frontend.txt"
    else
        echo "pendências em ${#files[@]} arquivo(s)" > "$REPORTS_DIR/resumo-frontend.txt"
    fi

    return "$status"
}

summary() {
    echo
    echo "================ Resumo ($PROJECT_NAME, base $BASE) ================"
    local tool label
    for tool in phpstan rector cobertura infection; do
        case "$tool" in
            phpstan)   label="PHPStan" ;;
            rector)    label="Rector" ;;
            cobertura) label="Cobertura" ;;
            infection) label="Infection" ;;
        esac
        printf '%-12s %s\n' "$label" "$(cat "$REPORTS_DIR/resumo-$tool.txt" 2>/dev/null || echo 'não rodou')"
    done
    echo "Relatórios em $REPORTS_DIR"
}

case "$COMMAND" in
    phpstan)   run_phpstan ;;
    rector)    run_rector ;;
    cobertura) run_coverage ;;
    infection) run_infection ;;
    frontend)  run_frontend ;;
    tudo)
        rm -f "$REPORTS_DIR"/phpstan.* "$REPORTS_DIR"/rector.* "$REPORTS_DIR"/cobertura.txt "$REPORTS_DIR"/infection.txt "$REPORTS_DIR"/infection.json "$REPORTS_DIR"/resumo-*.txt
        run_phpstan || true
        run_rector || true
        run_infection || true
        summary
        ;;
    *) echo "Comando desconhecido: $COMMAND" >&2; usage; exit 2 ;;
esac
